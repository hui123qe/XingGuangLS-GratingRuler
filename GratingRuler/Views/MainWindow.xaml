<Window
    x:Class="GratingRuler.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:GratingRuler.Views.Pages"
    xmlns:controls="clr-namespace:GratingRuler.Views.Controls"
    Width="1680"
    Height="980"
    MinWidth="1366"
    MinHeight="768"
    Title="光栅尺测试台"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- 01 标题与软件急停 -->
        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="光栅尺测试台" />
                <Button
                    Grid.Column="1"
                    Height="44"
                    VerticalAlignment="Center"
                    Style="{StaticResource StopButtonStyle}"
                    Content="软件急停"
                    Command="{Binding EmergencyStopCommand}"
                    AutomationProperties.Name="软件急停" />
            </Grid>
        </Border>

        <!-- 02 导航、业务页面、设备状态 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="14,18"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <ListBox
                    BorderThickness="0"
                    Background="Transparent"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}"
                    ItemsSource="{Binding Pages}"
                    SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                    AutomationProperties.Name="功能导航" />
            </Border>
            <ContentControl
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate><pages:TestWorkbenchView /></DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="参数设置">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate><pages:ParametersView DataContext="{Binding Parameters}" /></DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="维护界面">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><pages:MaintenanceView /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="运行记录">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><pages:RunRecordsView /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedPage}" Value="报警记录">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><pages:AlarmRecordsView /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <controls:DeviceStatusPanel Grid.Column="2" />
        </Grid>

        <!-- 03 版本、操作反馈与时间 -->
        <Border
            Grid.Row="2"
            Padding="18,0"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="V0.1.0　离线" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,16,0"
                    Text="{Binding OperationFeedback}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding OperationFeedback}"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="2" Text="{Binding ClockText}" />
            </Grid>
        </Border>
    </Grid>
</Window>

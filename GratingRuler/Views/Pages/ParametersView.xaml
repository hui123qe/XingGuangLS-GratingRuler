<UserControl x:Class="GratingRuler.Views.Pages.ParametersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="测试流程" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="添加步骤" Click="Add_Click" IsEnabled="{Binding CanEdit}" />
                <Button Margin="0,0,8,8" Content="编辑步骤" Click="Edit_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="IsEnabled" Value="{Binding CanEdit}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="0,0,8,8" Content="删除步骤" Command="{Binding DeleteStepCommand}" />
                <Button Margin="0,0,8,8" Content="前移" Command="{Binding MoveUpCommand}" />
                <Button Margin="0,0,8,8" Content="后移" Command="{Binding MoveDownCommand}" />
                <Button Margin="0,0,8,8" Content="保存流程" Command="{Binding SaveCommand}" />
                <Button Margin="0,0,8,8" Content="加载流程" Command="{Binding RestoreCommand}" />
            </WrapPanel>
            <WrapPanel>
                <Button Margin="0,0,8,8" Content="预览下一步" Command="{Binding NextPreviewCommand}" />
                <Button Margin="0,0,8,8" Content="重置预览" Command="{Binding ResetPreviewCommand}" />
                <TextBlock Margin="0,0,0,8" Text="双击圆圈编辑配置；新步骤插入在所选节点后。" Style="{StaticResource SecondaryTextStyle}" />
            </WrapPanel>
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="FlowNodes" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                    BorderThickness="0" Background="Transparent" Padding="24,60" AlternationCount="2147483647"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                    AutomationProperties.Name="测试流程节点">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <EventSetter Event="MouseDoubleClick" Handler="Node_DoubleClick" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="112" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Path x:Name="Arrow" Width="48" Height="16" Margin="0,0,0,0"
                                                VerticalAlignment="Center" Fill="#9CA8AD" Stretch="Fill"
                                                Data="M 0,5 L 34,5 L 34,0 L 48,8 L 34,16 L 34,11 L 0,11 Z" />
                                            <Grid Grid.Column="1" Width="112" Height="112">
                                                <Ellipse x:Name="Circle" Fill="#E5EEEE" Stroke="#82979B" StrokeThickness="1.5" />
                                                <TextBlock Margin="12" Text="{Binding Name}" TextWrapping="Wrap"
                                                    TextAlignment="Center" MaxHeight="80" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,12,6,0">
                                                <TextBlock Text="{Binding TaskName}" TextWrapping="Wrap" TextAlignment="Center" />
                                                <TextBlock Margin="0,6,0,0" Text="{Binding Pose, StringFormat='Rx/Ry/Rz: {0} °'}"
                                                    FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Range, StringFormat='行程: {0} mm'}"
                                                    FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Circle" Property="Fill" Value="#9CD4D6" />
                                                <Setter TargetName="Circle" Property="Stroke" Value="#176E78" />
                                                <Setter TargetName="Circle" Property="StrokeThickness" Value="3" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="Circle" Property="Stroke" Value="#176E78" />
                                                <Setter TargetName="Circle" Property="StrokeThickness" Value="3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryBrush}"
                    Text="点击“添加步骤”，配置完成后在此生成流程节点。" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" Text="{Binding Feedback}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
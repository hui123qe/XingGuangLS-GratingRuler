<UserControl
    x:Class="GratingRuler.Views.Pages.ParametersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <DataTemplate x:Key="ParameterTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="FieldLabel"
                    Content="{Binding Label}"
                    Target="{Binding ElementName=ValueInput}" />
                <TextBox
                    x:Name="ValueInput"
                    Grid.Column="1"
                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding Label}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <ComboBox
                    x:Name="ChoiceInput"
                    Grid.Column="1"
                    ItemsSource="{Binding Choices}"
                    SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding IsChoice, Converter={StaticResource BooleanVisibility}}"
                    AutomationProperties.Name="{Binding Label}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Text="{Binding Unit}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    FontSize="12"
                    Foreground="DarkRed"
                    Text="{Binding Error}"
                    TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChoice}" Value="True">
                    <Setter TargetName="FieldLabel" Property="Target" Value="{Binding ElementName=ChoiceInput}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="参数设置" />

        <!-- 01 测试对象与参数 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}">
                <GroupBox Margin="0,0,0,12" Header="测试对象">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="44" />
                            <RowDefinition Height="Auto" MinHeight="44" />
                            <RowDefinition Height="Auto" MinHeight="44" />
                            <RowDefinition Height="Auto" MinHeight="44" />
                        </Grid.RowDefinitions>
                        <Label Content="被测类型" Target="{Binding ElementName=DutSelector}" />
                        <ComboBox
                            x:Name="DutSelector"
                            Grid.Column="1"
                            Margin="0,4,20,4"
                            ItemsSource="{Binding DutTypes}"
                            SelectedItem="{Binding DutType, Mode=TwoWay}" />
                        <Label
                            Grid.Column="2"
                            Content="设备编号"
                            Target="{Binding ElementName=DeviceInput}" />
                        <TextBox
                            x:Name="DeviceInput"
                            Grid.Column="3"
                            Margin="0,4,0,4"
                            Text="{Binding DeviceId, UpdateSourceTrigger=PropertyChanged}" />
                        <Label
                            Grid.Row="1"
                            Content="测试项目"
                            Target="{Binding ElementName=TaskSelector}" />
                        <ComboBox
                            x:Name="TaskSelector"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,4,20,4"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding AvailableTasks}"
                            SelectedItem="{Binding SelectedTask, Mode=TwoWay}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="2"
                            Content="批次"
                            Target="{Binding ElementName=BatchInput}" />
                        <TextBox
                            x:Name="BatchInput"
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="0,4,0,4"
                            Text="{Binding Batch, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="2" Content="测试台" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,4,20,4"
                            Text="{Binding Bench}" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="2"
                            Content="测量基准"
                            Target="{Binding ElementName=ReferenceSelector}" />
                        <ComboBox
                            x:Name="ReferenceSelector"
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,4,0,4"
                            ItemsSource="{Binding References}"
                            SelectedItem="{Binding Reference, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.ColumnSpan="4"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{Binding TaskNote}"
                            TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <GroupBox Margin="0,0,6,0" Header="{Binding MotionTitle}">
                        <ItemsControl ItemsSource="{Binding MotionFields}" ItemTemplate="{StaticResource ParameterTemplate}" />
                    </GroupBox>
                    <GroupBox
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Header="采集参数">
                        <ItemsControl ItemsSource="{Binding MeasurementFields}" ItemTemplate="{StaticResource ParameterTemplate}" />
                    </GroupBox>
                </Grid>
                <GroupBox
                    Margin="0,12,0,0"
                    Header="测试前姿态"
                    Visibility="{Binding HasPose, Converter={StaticResource BooleanVisibility}}">
                    <ItemsControl ItemsSource="{Binding PoseFields}" ItemTemplate="{StaticResource ParameterTemplate}" />
                </GroupBox>
                <GroupBox
                    Margin="0,12,0,0"
                    Header="速度与加速度分析"
                    Visibility="{Binding IsSpeed, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Text="被测端：传感器自身计算输出。按实际运动数据识别匀速、加速、减速有效区间；区间两端按剔除时长排除。"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AnalysisFields}" ItemTemplate="{StaticResource ParameterTemplate}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Text="误差限值为最大绝对误差。时间修正加到被测时间戳上，再与基准时间对齐；无有效区间或样本不足时无法评价。"
                            TextWrapping="Wrap" />
                        <GroupBox
                            Margin="0,12,0,0"
                            Header="基准位置计算"
                            Visibility="{Binding IsReferenceCalculated, Converter={StaticResource BooleanVisibility}}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Text="计算约定：位置居中滑动平均后，用对称窗口端点差分得到速度，再差分得到加速度；窗口均为奇数，平滑窗口为 1 表示不滤波。边界缺失样本不参与评价。"
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding CalculationFields}" ItemTemplate="{StaticResource ParameterTemplate}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>
                <TextBlock
                    Margin="0,12,0,12"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="参数为草稿配置；设备行程、通道及同步能力需接入后核验。采集与分析执行器尚未接入。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 02 保存与锁定 -->
        <Border
            Grid.Row="2"
            Margin="0,12,0,0"
            Padding="0,12,0,0"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Text="{Binding Feedback}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding LockText}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Margin="8,0,0,0"
                            Content="保存草稿"
                            Command="{Binding SaveCommand}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="恢复草稿"
                            Command="{Binding RestoreCommand}" />
                        <Button
                            Margin="8,0,0,0"
                            Content="解锁编辑"
                            Command="{Binding UnlockCommand}" />
                        <Button
                            Margin="8,0,0,0"
                            Background="{StaticResource NavigationBrush}"
                            Content="确认并锁定"
                            Command="{Binding LockCommand}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


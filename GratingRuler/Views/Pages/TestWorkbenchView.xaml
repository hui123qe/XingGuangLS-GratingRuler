<UserControl
    x:Class="GratingRuler.Views.Pages.TestWorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="0.55*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- 01 当前任务 -->
        <DockPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="测试工作台" />
            <TextBlock
                Margin="20,0,0,14"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryTextStyle}"
                Text="空闲" />
        </DockPanel>
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{Binding Parameters.SelectedTask.DisplayName}" />
                    <WrapPanel>
                        <TextBlock Margin="0,0,20,0" Text="{Binding Parameters.DutType}" />
                        <TextBlock Margin="0,0,20,0" Text="{Binding Parameters.Bench}" />
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="设备：" /><Run Text="{Binding Parameters.DeviceText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="批次：" /><Run Text="{Binding Parameters.BatchText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Parameters.LockText}" />
                    </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="设置参数"
                    Command="{Binding OpenParametersCommand}" />
            </Grid>
        </Border>

        <!-- 02 读数、曲线与执行 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,10" Style="{StaticResource PanelStyle}">
                    <UniformGrid Rows="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="直线电机 X 轴位置 / mm" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                Text="--" />
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Parameters.HasYAxis}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="直线电机 Y 轴位置 / mm" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                Text="--" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="测量曲线" />
                        <Border
                            Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                            <Border.Background>
                                <DrawingBrush
                                    TileMode="Tile"
                                    Viewport="0,0,60,40"
                                    ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="White" Geometry="M0,0 H60 V40 H0 Z" />
                                            <GeometryDrawing Geometry="M0,0 H60 V40">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#E6E6E6" Thickness="1" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="暂无数据" />
                        </Border>
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{Binding CurveCaption}" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel VerticalAlignment="Bottom">
                    <Button
                        Margin="0,0,0,10"
                        MinWidth="0"
                        Style="{StaticResource StartButtonStyle}"
                        Content="启动测试"
                        Command="{Binding UnavailableDeviceCommand}" />
                    <Button
                        MinWidth="0"
                        Style="{StaticResource StopButtonStyle}"
                        Content="停止测试"
                        Command="{Binding UnavailableDeviceCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 03 结果记录区域暂时留白，保留布局空间。 -->
    </Grid>
</UserControl>


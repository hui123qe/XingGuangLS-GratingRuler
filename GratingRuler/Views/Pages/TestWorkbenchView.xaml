<UserControl
    x:Class="GratingRuler.Views.Pages.TestWorkbenchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GratingRuler.Views.Controls">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="0.55*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- 01 当前任务 -->
        <DockPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="测试工作台" />
            <TextBlock
                Margin="20,0,0,14"
                HorizontalAlignment="Right"
                Style="{StaticResource SecondaryTextStyle}"
                Text="空闲" />
        </DockPanel>
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{Binding Parameters.SelectedTask.DisplayName}" />
                    <WrapPanel>
                        <TextBlock Margin="0,0,20,0" Text="{Binding Parameters.DutType}" />
                        <TextBlock Margin="0,0,20,0" Text="{Binding Parameters.Bench}" />
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="设备：" /><Run Text="{Binding Parameters.DeviceText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,0,20,0">
                            <Run Text="批次：" /><Run Text="{Binding Parameters.BatchText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Parameters.LockText}" />
                    </WrapPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Content="设置参数"
                    Command="{Binding OpenParametersCommand}" />
            </Grid>
        </Border>

        <!-- 02 读数、曲线与执行 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,10" Style="{StaticResource PanelStyle}">
                    <UniformGrid Columns="3">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding PrimaryReadingLabel}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                Text="--" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding SecondaryReadingLabel}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                Text="--" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding ResultReadingLabel}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="22"
                                Text="--" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="测量曲线" />
                        <Border
                            Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                            <Border.Background>
                                <DrawingBrush
                                    TileMode="Tile"
                                    Viewport="0,0,60,40"
                                    ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="White" Geometry="M0,0 H60 V40 H0 Z" />
                                            <GeometryDrawing Geometry="M0,0 H60 V40">
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#E6E6E6" Thickness="1" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryTextStyle}"
                                Text="暂无数据" />
                        </Border>
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{Binding CurveCaption}" />
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="控制与执行" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="0,4,0,14" Text="当前步骤：待机" />
                        <TextBlock Margin="0,0,0,10" Text="循环：--　　方向：--" />
                        <TextBlock Margin="0,0,0,10" Text="点位：-- / --" />
                        <TextBlock Margin="0,0,0,10" Text="已用时间：--" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="设备未连接" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Margin="0,0,5,0"
                            MinWidth="0"
                            Style="{StaticResource StartButtonStyle}"
                            Content="启动测试"
                            Command="{Binding UnavailableDeviceCommand}" />
                        <Button
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            MinWidth="0"
                            Style="{StaticResource StopButtonStyle}"
                            Content="停止测试"
                            Command="{Binding UnavailableDeviceCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 03 点位与结果 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding RecordTitle}" />
            <controls:MeasurementRecordsView Grid.Row="1" />
            <TextBlock
                Grid.Row="2"
                Margin="0,8,0,0"
                Style="{StaticResource SecondaryTextStyle}"
                Text="{Binding ResultSummary}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</UserControl>


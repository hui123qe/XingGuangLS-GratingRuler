<UserControl
    x:Class="GratingRuler.Views.Pages.RunRecordsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="实验记录" />
        <!-- 01 查询条件 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource PanelStyle}">
            <WrapPanel>
                <Label Content="日期" Target="{Binding ElementName=StartDate}" />
                <DatePicker
                    x:Name="StartDate"
                    Width="140"
                    Height="32"
                    Margin="0,0,8,6"
                    SelectedDate="{Binding FromDate, Mode=TwoWay}" />
                <TextBlock Margin="0,0,8,6" Text="至" />
                <DatePicker
                    Width="140"
                    Height="32"
                    Margin="0,0,16,6"
                    SelectedDate="{Binding ToDate, Mode=TwoWay}"
                    AutomationProperties.Name="结束日期" />
                <TextBox
                    Width="180"
                    Margin="0,0,8,6"
                    Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="设备编号或批次"
                    AutomationProperties.Name="设备编号或批次关键词" />
                <Button
                    Margin="0,0,8,6"
                    Content="查询"
                    Command="{Binding QueryRecordsCommand}" />
                <Button
                    Margin="0,0,0,6"
                    Content="清除条件"
                    Command="{Binding ClearRecordFilterCommand}" />
            </WrapPanel>
        </Border>
        <!-- 02 会话记录 -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Sessions}" AutomationProperties.Name="实验记录">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="160"
                        Header="会话编号"
                        Binding="{Binding Id}" />
                    <DataGridTextColumn
                        Width="160"
                        Header="开始时间"
                        Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                    <DataGridTextColumn
                        Width="100"
                        Header="批次"
                        Binding="{Binding Batch}" />
                    <DataGridTextColumn
                        Width="120"
                        Header="设备"
                        Binding="{Binding Dut}" />
                    <DataGridTextColumn
                        Width="120"
                        Header="任务"
                        Binding="{Binding Task}" />
                    <DataGridTextColumn
                        Width="90"
                        Header="结束状态"
                        Binding="{Binding State}" />
                    <DataGridTextColumn
                        Width="90"
                        Header="质量"
                        Binding="{Binding Quality}" />
                    <DataGridTextColumn
                        Width="90"
                        Header="判定"
                        Binding="{Binding Verdict}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="暂无记录"
                Visibility="{Binding Sessions.Count, Converter={StaticResource EmptyVisibilityConverter}}"
                IsHitTestVisible="False" />
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding RecordFeedback}" />
            <Button
                HorizontalAlignment="Right"
                Content="导出所选"
                IsEnabled="False"
                ToolTip="暂无可导出的记录" />
        </DockPanel>
    </Grid>
</UserControl>


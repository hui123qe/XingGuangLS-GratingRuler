<UserControl
    x:Class="GratingRuler.Views.Pages.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="维护界面" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- 01 连接诊断 -->
                <GroupBox Margin="0,0,0,12" Header="设备连接">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运动控制器" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="未连接" />
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <Button
                                Margin="6,4"
                                Content="连接"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="6,4"
                                Content="断开"
                                Command="{Binding UnavailableDeviceCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="被测设备" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="未连接" />
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <Button
                                Margin="6,4"
                                Content="连接"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="6,4"
                                Content="断开"
                                Command="{Binding UnavailableDeviceCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="测量基准" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="未连接" />
                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <Button
                                Margin="6,4"
                                Content="连接"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="6,4"
                                Content="断开"
                                Command="{Binding UnavailableDeviceCommand}" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="采集设备" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="未连接" />
                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="2"
                            Orientation="Horizontal">
                            <Button
                                Margin="6,4"
                                Content="连接"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="6,4"
                                Content="断开"
                                Command="{Binding UnavailableDeviceCommand}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <!-- 02 手动运动，设备接入前禁止执行 -->
                <GroupBox Margin="0,0,0,12" Header="轴控制">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,14">
                            <TextBlock Margin="0,0,24,0" Text="轴：未配置" />
                            <TextBlock Margin="0,0,24,0" Text="实际位置：-- mm" />
                            <TextBlock Margin="0,0,24,0" Text="使能：未知" />
                            <TextBlock Text="限位：未知" />
                        </WrapPanel>
                        <Grid IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>
                            <Label Content="目标位置" Target="{Binding ElementName=TargetPosition}" />
                            <TextBox
                                x:Name="TargetPosition"
                                Grid.Column="1"
                                Margin="0,4,12,4"
                                Text="--"
                                IsReadOnly="True" />
                            <TextBlock Grid.Column="2" Text="mm" />
                            <Label
                                Grid.Row="1"
                                Content="速度"
                                Target="{Binding ElementName=Velocity}" />
                            <TextBox
                                x:Name="Velocity"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,12,4"
                                Text="--"
                                IsReadOnly="True" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Text="mm/s" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button
                                Margin="0,0,10,8"
                                Content="使能"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="0,0,10,8"
                                Content="定位"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="0,0,10,8"
                                Content="JOG −"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="0,0,10,8"
                                Content="JOG ＋"
                                Command="{Binding UnavailableDeviceCommand}" />
                            <Button
                                Margin="0,0,10,8"
                                Content="停止"
                                Command="{Binding UnavailableDeviceCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
                <TextBlock
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="设备接口尚未接入，手动操作不可用。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

